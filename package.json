{
  "name": "orangehrm-e2e-playwright",
  "version": "1.0.0",
  "description": "Automatizacion E2E del sitio OrangeHRM con Playwright + TypeScript usando Page Object Model, manejo de archivos y reporte HTML. Evaluacion tecnica perfil QA.",
  "main": "index.js",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:login": "playwright test tests/01-login.spec.ts",
    "test:pim": "playwright test tests/02-pim.spec.ts",
    "test:recruitment": "playwright test tests/03-recruitment.spec.ts",
    "test:buzz": "playwright test tests/04-buzz.spec.ts",
    "report": "playwright show-report"
  },
  "keywords": [
    "playwright",
    "typescript",
    "qa",
    "e2e",
    "orangehrm",
    "page-object-model",
    "automation"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.3",
    "typescript": "^5.6.3"
  }
}
